using System;
using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.UI;
using TMPro;
using Cristal.CLI.Labyrinth.Dream.Journal;

namespace Cristal.CLI.Labyrinth.Dream.UI
{
    /// <summary>
    /// UI for viewing the Dream Journal.
    /// Displays dream records, symbols, and patterns.
    /// </summary>
    public class DreamJournalUI : MonoBehaviour
    {
        public static DreamJournalUI Instance { get; private set; }

        [Header("Main Panel")]
        [SerializeField] private GameObject _journalPanel;
        [SerializeField] private CanvasGroup _journalCanvasGroup;
        [SerializeField] private float _fadeSpeed = 3f;

        [Header("Navigation")]
        [SerializeField] private Button _tabDreamsButton;
        [SerializeField] private Button _tabSymbolsButton;
        [SerializeField] private Button _tabPatternsButton;
        [SerializeField] private Button _tabStatsButton;
        [SerializeField] private Button _closeButton;

        [Header("Dreams Tab")]
        [SerializeField] private RectTransform _dreamListContainer;
        [SerializeField] private GameObject _dreamEntryPrefab;
        [SerializeField] private RectTransform _dreamDetailPanel;
        [SerializeField] private TextMeshProUGUI _dreamDetailTitle;
        [SerializeField] private TextMeshProUGUI _dreamDetailBody;
        [SerializeField] private TextMeshProUGUI _dreamDetailNarratives;
        [SerializeField] private Image _dreamColorPreview;

        [Header("Symbols Tab")]
        [SerializeField] private RectTransform _symbolListContainer;
        [SerializeField] private GameObject _symbolEntryPrefab;
        [SerializeField] private TextMeshProUGUI _symbolDetailText;

        [Header("Patterns Tab")]
        [SerializeField] private RectTransform _patternListContainer;
        [SerializeField] private GameObject _patternEntryPrefab;

        [Header("Stats Tab")]
        [SerializeField] private TextMeshProUGUI _statsText;

        [Header("Tab Panels")]
        [SerializeField] private GameObject _dreamsTabPanel;
        [SerializeField] private GameObject _symbolsTabPanel;
        [SerializeField] private GameObject _patternsTabPanel;
        [SerializeField] private GameObject _statsTabPanel;

        [Header("Colors")]
        [SerializeField] private Color _tabActiveColor = new Color(0.3f, 0.2f, 0.5f);
        [SerializeField] private Color _tabInactiveColor = new Color(0.15f, 0.1f, 0.2f);
        [SerializeField] private Color _unboundColor = new Color(0.8f, 0.1f, 1f);

        // State
        private bool _isOpen;
        private bool _isTransitioning;
        private JournalTab _currentTab = JournalTab.Dreams;
        private DreamRecord _selectedDream;
        private List<GameObject> _dreamEntries = new List<GameObject>();
        private List<GameObject> _symbolEntries = new List<GameObject>();
        private List<GameObject> _patternEntries = new List<GameObject>();

        // Properties
        public bool IsOpen => _isOpen;

        #region Unity Lifecycle

        private void Awake()
        {
            if (Instance != null && Instance != this)
            {
                Destroy(gameObject);
                return;
            }
            Instance = this;

            InitializeUI();
        }

        private void Start()
        {
            // Subscribe to journal events
            var journal = DreamJournal.Instance;
            if (journal != null)
            {
                journal.OnDreamRecorded += HandleDreamRecorded;
                journal.OnJournalLoaded += RefreshCurrentTab;
            }

            // Start closed
            if (_journalPanel != null)
            {
                _journalPanel.SetActive(false);
            }
            if (_journalCanvasGroup != null)
            {
                _journalCanvasGroup.alpha = 0f;
            }
        }

        private void Update()
        {
            // Toggle with J key
            if (Input.GetKeyDown(KeyCode.J) && !DreamTunnelSystem.Instance?.IsInDream == true)
            {
                Toggle();
            }

            // Close with Escape
            if (Input.GetKeyDown(KeyCode.Escape) && _isOpen)
            {
                Close();
            }
        }

        private void OnDestroy()
        {
            var journal = DreamJournal.Instance;
            if (journal != null)
            {
                journal.OnDreamRecorded -= HandleDreamRecorded;
                journal.OnJournalLoaded -= RefreshCurrentTab;
            }

            if (Instance == this)
            {
                Instance = null;
            }
        }

        #endregion

        #region Initialization

        private void InitializeUI()
        {
            // Setup tab buttons
            if (_tabDreamsButton != null)
            {
                _tabDreamsButton.onClick.AddListener(() => SwitchTab(JournalTab.Dreams));
            }
            if (_tabSymbolsButton != null)
            {
                _tabSymbolsButton.onClick.AddListener(() => SwitchTab(JournalTab.Symbols));
            }
            if (_tabPatternsButton != null)
            {
                _tabPatternsButton.onClick.AddListener(() => SwitchTab(JournalTab.Patterns));
            }
            if (_tabStatsButton != null)
            {
                _tabStatsButton.onClick.AddListener(() => SwitchTab(JournalTab.Stats));
            }
            if (_closeButton != null)
            {
                _closeButton.onClick.AddListener(Close);
            }

            // Create containers if missing
            EnsureContainers();
        }

        private void EnsureContainers()
        {
            if (_journalPanel == null)
            {
                _journalPanel = new GameObject("JournalPanel");
                _journalPanel.transform.SetParent(transform);

                var rect = _journalPanel.AddComponent<RectTransform>();
                rect.anchorMin = Vector2.zero;
                rect.anchorMax = Vector2.one;
                rect.sizeDelta = Vector2.zero;

                _journalCanvasGroup = _journalPanel.AddComponent<CanvasGroup>();

                var bg = _journalPanel.AddComponent<Image>();
                bg.color = new Color(0.05f, 0.03f, 0.08f, 0.95f);
            }
        }

        #endregion

        #region Open/Close

        public void Toggle()
        {
            if (_isOpen)
            {
                Close();
            }
            else
            {
                Open();
            }
        }

        public void Open()
        {
            if (_isOpen || _isTransitioning) return;

            _journalPanel.SetActive(true);
            StartCoroutine(FadeIn());
            RefreshCurrentTab();
        }

        public void Close()
        {
            if (!_isOpen || _isTransitioning) return;

            StartCoroutine(FadeOut());
        }

        private IEnumerator FadeIn()
        {
            _isTransitioning = true;

            while (_journalCanvasGroup.alpha < 1f)
            {
                _journalCanvasGroup.alpha += Time.deltaTime * _fadeSpeed;
                yield return null;
            }

            _journalCanvasGroup.alpha = 1f;
            _isOpen = true;
            _isTransitioning = false;
        }

        private IEnumerator FadeOut()
        {
            _isTransitioning = true;

            while (_journalCanvasGroup.alpha > 0f)
            {
                _journalCanvasGroup.alpha -= Time.deltaTime * _fadeSpeed;
                yield return null;
            }

            _journalCanvasGroup.alpha = 0f;
            _journalPanel.SetActive(false);
            _isOpen = false;
            _isTransitioning = false;
        }

        #endregion

        #region Tab Navigation

        private void SwitchTab(JournalTab tab)
        {
            _currentTab = tab;

            // Update tab button colors
            UpdateTabButton(_tabDreamsButton, tab == JournalTab.Dreams);
            UpdateTabButton(_tabSymbolsButton, tab == JournalTab.Symbols);
            UpdateTabButton(_tabPatternsButton, tab == JournalTab.Patterns);
            UpdateTabButton(_tabStatsButton, tab == JournalTab.Stats);

            // Show/hide panels
            if (_dreamsTabPanel != null) _dreamsTabPanel.SetActive(tab == JournalTab.Dreams);
            if (_symbolsTabPanel != null) _symbolsTabPanel.SetActive(tab == JournalTab.Symbols);
            if (_patternsTabPanel != null) _patternsTabPanel.SetActive(tab == JournalTab.Patterns);
            if (_statsTabPanel != null) _statsTabPanel.SetActive(tab == JournalTab.Stats);

            RefreshCurrentTab();
        }

        private void UpdateTabButton(Button button, bool active)
        {
            if (button == null) return;

            var colors = button.colors;
            colors.normalColor = active ? _tabActiveColor : _tabInactiveColor;
            button.colors = colors;
        }

        private void RefreshCurrentTab()
        {
            switch (_currentTab)
            {
                case JournalTab.Dreams:
                    RefreshDreamsList();
                    break;
                case JournalTab.Symbols:
                    RefreshSymbolsList();
                    break;
                case JournalTab.Patterns:
                    RefreshPatternsList();
                    break;
                case JournalTab.Stats:
                    RefreshStats();
                    break;
            }
        }

        #endregion

        #region Dreams Tab

        private void RefreshDreamsList()
        {
            // Clear existing entries
            foreach (var entry in _dreamEntries)
            {
                Destroy(entry);
            }
            _dreamEntries.Clear();

            var journal = DreamJournal.Instance;
            if (journal == null) return;

            foreach (var dream in journal.AllDreams)
            {
                CreateDreamEntry(dream);
            }

            // Select first if nothing selected
            if (_selectedDream == null && journal.DreamCount > 0)
            {
                SelectDream(journal.GetMostRecentDream());
            }
        }

        private void CreateDreamEntry(DreamRecord dream)
        {
            GameObject entry;

            if (_dreamEntryPrefab != null)
            {
                entry = Instantiate(_dreamEntryPrefab, _dreamListContainer);
            }
            else
            {
                entry = CreateDefaultDreamEntry();
            }

            // Setup entry
            var titleText = entry.GetComponentInChildren<TextMeshProUGUI>();
            if (titleText != null)
            {
                titleText.text = dream.GetDisplayTitle();
                if (dream.wasUnbound)
                {
                    titleText.color = _unboundColor;
                }
            }

            // Setup click handler
            var button = entry.GetComponent<Button>();
            if (button == null)
            {
                button = entry.AddComponent<Button>();
            }
            button.onClick.AddListener(() => SelectDream(dream));

            // Color indicator
            var colorIndicator = entry.transform.Find("ColorIndicator")?.GetComponent<Image>();
            if (colorIndicator != null)
            {
                colorIndicator.color = dream.primaryColor;
            }

            _dreamEntries.Add(entry);
        }

        private GameObject CreateDefaultDreamEntry()
        {
            var entry = new GameObject("DreamEntry");
            entry.transform.SetParent(_dreamListContainer);

            var rect = entry.AddComponent<RectTransform>();
            rect.sizeDelta = new Vector2(0, 40);

            var layout = entry.AddComponent<HorizontalLayoutGroup>();
            layout.padding = new RectOffset(10, 10, 5, 5);
            layout.spacing = 10;

            // Color indicator
            var colorObj = new GameObject("ColorIndicator");
            colorObj.transform.SetParent(entry.transform);
            var colorRect = colorObj.AddComponent<RectTransform>();
            colorRect.sizeDelta = new Vector2(10, 30);
            var colorImage = colorObj.AddComponent<Image>();

            // Title
            var titleObj = new GameObject("Title");
            titleObj.transform.SetParent(entry.transform);
            var titleRect = titleObj.AddComponent<RectTransform>();
            var titleText = titleObj.AddComponent<TextMeshProUGUI>();
            titleText.fontSize = 14;
            titleText.alignment = TextAlignmentOptions.Left;

            // Background
            var bgImage = entry.AddComponent<Image>();
            bgImage.color = new Color(0.1f, 0.08f, 0.15f, 0.8f);

            return entry;
        }

        private void SelectDream(DreamRecord dream)
        {
            _selectedDream = dream;
            UpdateDreamDetail();
        }

        private void UpdateDreamDetail()
        {
            if (_selectedDream == null) return;

            var dream = _selectedDream;

            // Title
            if (_dreamDetailTitle != null)
            {
                _dreamDetailTitle.text = dream.GetDisplayTitle();
                _dreamDetailTitle.color = dream.wasUnbound ? _unboundColor : Color.white;
            }

            // Body
            if (_dreamDetailBody != null)
            {
                var sb = new System.Text.StringBuilder();
                sb.AppendLine($"<color=#888888>{dream.timestamp}</color>");
                sb.AppendLine();
                sb.AppendLine($"<b>Duration:</b> {dream.duration:F1} seconds");
                sb.AppendLine($"<b>Rooms Explored:</b> {dream.roomsVisited}/{dream.roomCount}");
                sb.AppendLine($"<b>Exit:</b> {dream.GetSummary()}");
                sb.AppendLine();
                sb.AppendLine($"<b>Emotional Journey:</b>");
                sb.AppendLine($"  Entry: {dream.entryEmotionalWeight:+0.0;-0.0;0}");
                sb.AppendLine($"  Exit: {dream.exitEmotionalWeight:+0.0;-0.0;0}");
                sb.AppendLine($"  Dominant: {dream.dominantEmotionDuring}");

                if (dream.symbolsEncountered.Count > 0)
                {
                    sb.AppendLine();
                    sb.AppendLine($"<b>Symbols ({dream.symbolsEncountered.Count}):</b>");
                    var significant = dream.GetSignificantSymbols(5);
                    foreach (var symbol in significant)
                    {
                        sb.AppendLine($"  • {symbol.symbolName}");
                    }
                }

                _dreamDetailBody.text = sb.ToString();
            }

            // Narratives
            if (_dreamDetailNarratives != null)
            {
                var sb = new System.Text.StringBuilder();

                if (dream.wallTexts.Count > 0)
                {
                    sb.AppendLine("<b>Wall Inscriptions:</b>");
                    foreach (var text in dream.wallTexts)
                    {
                        sb.AppendLine($"<i>\"{text}\"</i>");
                    }
                    sb.AppendLine();
                }

                if (dream.whispers.Count > 0)
                {
                    sb.AppendLine("<b>Whispers:</b>");
                    foreach (var whisper in dream.whispers)
                    {
                        sb.AppendLine($"<i>...{whisper}...</i>");
                    }
                }

                _dreamDetailNarratives.text = sb.ToString();
            }

            // Color preview
            if (_dreamColorPreview != null)
            {
                _dreamColorPreview.color = dream.primaryColor;
            }
        }

        #endregion

        #region Symbols Tab

        private void RefreshSymbolsList()
        {
            foreach (var entry in _symbolEntries)
            {
                Destroy(entry);
            }
            _symbolEntries.Clear();

            var tracker = DreamSymbolTracker.Instance;
            if (tracker == null) return;

            var symbols = tracker.GetMostSignificantSymbols(50);

            foreach (var symbol in symbols)
            {
                CreateSymbolEntry(symbol);
            }
        }

        private void CreateSymbolEntry(DreamSymbolRecord symbol)
        {
            GameObject entry;

            if (_symbolEntryPrefab != null)
            {
                entry = Instantiate(_symbolEntryPrefab, _symbolListContainer);
            }
            else
            {
                entry = CreateDefaultSymbolEntry();
            }

            var titleText = entry.GetComponentInChildren<TextMeshProUGUI>();
            if (titleText != null)
            {
                string categoryColor = GetCategoryColor(symbol.category);
                titleText.text = $"<color={categoryColor}>{symbol.symbolName}</color> <size=10>({symbol.category})</size>";
            }

            // Significance bar
            var sigBar = entry.transform.Find("SignificanceBar")?.GetComponent<Image>();
            if (sigBar != null)
            {
                sigBar.fillAmount = symbol.significance;
            }

            _symbolEntries.Add(entry);
        }

        private GameObject CreateDefaultSymbolEntry()
        {
            var entry = new GameObject("SymbolEntry");
            entry.transform.SetParent(_symbolListContainer);

            var rect = entry.AddComponent<RectTransform>();
            rect.sizeDelta = new Vector2(0, 30);

            var titleObj = new GameObject("Title");
            titleObj.transform.SetParent(entry.transform);
            var titleText = titleObj.AddComponent<TextMeshProUGUI>();
            titleText.fontSize = 12;

            var bgImage = entry.AddComponent<Image>();
            bgImage.color = new Color(0.1f, 0.08f, 0.15f, 0.6f);

            return entry;
        }

        private string GetCategoryColor(SymbolCategory category)
        {
            return category switch
            {
                SymbolCategory.Arcana => "#FFD700",
                SymbolCategory.Emotion => "#FF6B9D",
                SymbolCategory.Memory => "#7B68EE",
                SymbolCategory.Vision => "#00CED1",
                SymbolCategory.Ritual => "#FF4500",
                SymbolCategory.Personal => "#98FB98",
                SymbolCategory.Universal => "#FFFFFF",
                SymbolCategory.Glitch => "#FF00FF",
                _ => "#AAAAAA"
            };
        }

        #endregion

        #region Patterns Tab

        private void RefreshPatternsList()
        {
            foreach (var entry in _patternEntries)
            {
                Destroy(entry);
            }
            _patternEntries.Clear();

            var tracker = DreamSymbolTracker.Instance;
            if (tracker == null) return;

            foreach (var pattern in tracker.DetectedPatterns)
            {
                CreatePatternEntry(pattern);
            }

            if (tracker.DetectedPatterns.Count == 0)
            {
                CreateNoPatternMessage();
            }
        }

        private void CreatePatternEntry(SymbolPattern pattern)
        {
            GameObject entry;

            if (_patternEntryPrefab != null)
            {
                entry = Instantiate(_patternEntryPrefab, _patternListContainer);
            }
            else
            {
                entry = CreateDefaultPatternEntry();
            }

            var titleText = entry.transform.Find("Title")?.GetComponent<TextMeshProUGUI>();
            if (titleText != null)
            {
                titleText.text = pattern.patternName;
            }

            var descText = entry.transform.Find("Description")?.GetComponent<TextMeshProUGUI>();
            if (descText != null)
            {
                descText.text = pattern.description;
            }

            _patternEntries.Add(entry);
        }

        private GameObject CreateDefaultPatternEntry()
        {
            var entry = new GameObject("PatternEntry");
            entry.transform.SetParent(_patternListContainer);

            var rect = entry.AddComponent<RectTransform>();
            rect.sizeDelta = new Vector2(0, 60);

            var layout = entry.AddComponent<VerticalLayoutGroup>();
            layout.padding = new RectOffset(10, 10, 5, 5);

            var titleObj = new GameObject("Title");
            titleObj.transform.SetParent(entry.transform);
            var titleText = titleObj.AddComponent<TextMeshProUGUI>();
            titleText.fontSize = 14;
            titleText.fontStyle = FontStyles.Bold;

            var descObj = new GameObject("Description");
            descObj.transform.SetParent(entry.transform);
            var descText = descObj.AddComponent<TextMeshProUGUI>();
            descText.fontSize = 11;
            descText.fontStyle = FontStyles.Italic;
            descText.color = new Color(0.7f, 0.7f, 0.7f);

            var bgImage = entry.AddComponent<Image>();
            bgImage.color = new Color(0.15f, 0.1f, 0.2f, 0.8f);

            return entry;
        }

        private void CreateNoPatternMessage()
        {
            var msg = new GameObject("NoPatterns");
            msg.transform.SetParent(_patternListContainer);

            var rect = msg.AddComponent<RectTransform>();
            rect.sizeDelta = new Vector2(0, 40);

            var text = msg.AddComponent<TextMeshProUGUI>();
            text.text = "<i>No patterns detected yet. Keep dreaming...</i>";
            text.fontSize = 12;
            text.color = new Color(0.5f, 0.5f, 0.5f);
            text.alignment = TextAlignmentOptions.Center;

            _patternEntries.Add(msg);
        }

        #endregion

        #region Stats Tab

        private void RefreshStats()
        {
            if (_statsText == null) return;

            var journal = DreamJournal.Instance;
            if (journal == null)
            {
                _statsText.text = "No journal data available.";
                return;
            }

            var stats = journal.GetStatistics();
            var sb = new System.Text.StringBuilder();

            sb.AppendLine("<size=18><b>DREAM STATISTICS</b></size>");
            sb.AppendLine();
            sb.AppendLine($"<b>Total Dreams:</b> {stats.totalDreams}");
            sb.AppendLine($"<b>UNBOUND Dreams:</b> {stats.unboundDreams}");
            sb.AppendLine($"<b>Dreams with AI Content:</b> {stats.dreamsWithAI}");
            sb.AppendLine();
            sb.AppendLine($"<b>Total Time Dreaming:</b> {FormatTime(stats.totalDuration)}");
            sb.AppendLine($"<b>Average Dream Duration:</b> {stats.averageDuration:F1}s");
            sb.AppendLine();
            sb.AppendLine($"<b>Rooms Explored:</b> {stats.totalRoomsExplored}");
            sb.AppendLine($"<b>Cores Reached:</b> {stats.coresReached}");
            sb.AppendLine();
            sb.AppendLine($"<b>Symbols Encountered:</b> {stats.totalSymbolsEncountered}");
            sb.AppendLine($"<b>Narratives Witnessed:</b> {stats.totalNarratives}");

            if (stats.arcanaDreamCounts.Count > 0)
            {
                sb.AppendLine();
                sb.AppendLine("<b>Dreams by Arcana:</b>");
                var arcanaSystem = Arcana.ArcanaSystem.Instance;
                foreach (var kvp in stats.arcanaDreamCounts)
                {
                    var arcana = arcanaSystem?.GetArcana(kvp.Key);
                    string name = arcana?.name ?? $"Arcana {kvp.Key}";
                    sb.AppendLine($"  • {name}: {kvp.Value}");
                }
            }

            _statsText.text = sb.ToString();
        }

        private string FormatTime(float seconds)
        {
            if (seconds < 60) return $"{seconds:F0}s";
            if (seconds < 3600) return $"{seconds / 60:F0}m {seconds % 60:F0}s";
            return $"{seconds / 3600:F0}h {(seconds % 3600) / 60:F0}m";
        }

        #endregion

        #region Event Handlers

        private void HandleDreamRecorded(DreamRecord dream)
        {
            if (_isOpen && _currentTab == JournalTab.Dreams)
            {
                RefreshDreamsList();
            }
        }

        #endregion
    }

    public enum JournalTab
    {
        Dreams,
        Symbols,
        Patterns,
        Stats
    }
}
