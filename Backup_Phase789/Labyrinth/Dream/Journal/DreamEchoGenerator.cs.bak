using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using UnityEngine;
using Cristal.CLI.AI;
using Cristal.CLI.Memory;
using Cristal.CLI.Symbolic;

namespace Cristal.CLI.Labyrinth.Dream.Journal
{
    /// <summary>
    /// Generates dream echoes - AI-enhanced fragments from past dreams.
    /// Uses the DreamJournal as context to create new dream-like content
    /// that references and reinterprets past experiences.
    /// </summary>
    public class DreamEchoGenerator : MonoBehaviour
    {
        public static DreamEchoGenerator Instance { get; private set; }

        [Header("Configuration")]
        [SerializeField] private bool _enabled = true;
        [SerializeField] private float _echoDecayRate = 0.1f;
        [SerializeField] private int _maxContextDreams = 5;
        [SerializeField] private int _maxContextSymbols = 10;

        [Header("Echo Settings")]
        [SerializeField] private float _minimumEchoStrength = 0.3f;
        [SerializeField] private float _echoIntervalMin = 30f;
        [SerializeField] private float _echoIntervalMax = 120f;

        // Events
        public event Action<DreamEcho> OnEchoGenerated;
        public event Action<DreamEcho> OnEchoDisplayed;

        // State
        private List<DreamEcho> _generatedEchoes = new List<DreamEcho>();
        private Queue<DreamEcho> _pendingEchoes = new Queue<DreamEcho>();
        private float _nextEchoTime;
        private bool _isGenerating;

        #region Unity Lifecycle

        private void Awake()
        {
            if (Instance != null && Instance != this)
            {
                Destroy(gameObject);
                return;
            }
            Instance = this;
        }

        private void Start()
        {
            ScheduleNextEcho();

            // Subscribe to dream events
            if (DreamJournal.Instance != null)
            {
                DreamJournal.Instance.OnDreamRecorded += HandleDreamRecorded;
            }
        }

        private void Update()
        {
            if (!_enabled) return;

            // Check if it's time for a spontaneous echo
            if (Time.time >= _nextEchoTime && !_isGenerating)
            {
                TryGenerateSpontaneousEcho();
                ScheduleNextEcho();
            }
        }

        private void OnDestroy()
        {
            if (DreamJournal.Instance != null)
            {
                DreamJournal.Instance.OnDreamRecorded -= HandleDreamRecorded;
            }

            if (Instance == this)
            {
                Instance = null;
            }
        }

        #endregion

        #region Echo Generation

        /// <summary>
        /// Generate an echo from a specific past dream.
        /// </summary>
        public async Task<DreamEcho> GenerateEchoFromDream(DreamRecord sourceDream)
        {
            if (sourceDream == null || !_enabled) return null;

            _isGenerating = true;

            try
            {
                var context = BuildEchoContext(sourceDream);
                var prompt = BuildEchoPrompt(context, EchoType.DreamRecall);

                string aiResponse = await RequestAIGeneration(prompt);

                var echo = new DreamEcho
                {
                    Id = Guid.NewGuid().ToString(),
                    SourceDreamId = sourceDream.Id,
                    EchoType = EchoType.DreamRecall,
                    Text = aiResponse ?? GenerateFallbackEcho(sourceDream),
                    Strength = CalculateEchoStrength(sourceDream),
                    GeneratedAt = DateTime.Now,
                    SourceTheme = sourceDream.Theme,
                    IsAIGenerated = !string.IsNullOrEmpty(aiResponse)
                };

                // Add symbols from source
                if (sourceDream.Symbols.Count > 0)
                {
                    var symbol = sourceDream.Symbols[UnityEngine.Random.Range(0, sourceDream.Symbols.Count)];
                    echo.LinkedSymbols.Add(symbol.Symbol);
                }

                _generatedEchoes.Add(echo);
                OnEchoGenerated?.Invoke(echo);

                return echo;
            }
            finally
            {
                _isGenerating = false;
            }
        }

        /// <summary>
        /// Generate an echo that merges multiple past dreams.
        /// </summary>
        public async Task<DreamEcho> GenerateMergedEcho()
        {
            var dreams = DreamJournal.Instance?.GetAllDreams().ToList();
            if (dreams == null || dreams.Count < 2) return null;

            _isGenerating = true;

            try
            {
                // Pick 2-3 random dreams to merge
                var selectedDreams = dreams
                    .OrderBy(_ => UnityEngine.Random.value)
                    .Take(Mathf.Min(3, dreams.Count))
                    .ToList();

                var context = BuildMergedContext(selectedDreams);
                var prompt = BuildEchoPrompt(context, EchoType.DreamMerge);

                string aiResponse = await RequestAIGeneration(prompt);

                var echo = new DreamEcho
                {
                    Id = Guid.NewGuid().ToString(),
                    EchoType = EchoType.DreamMerge,
                    Text = aiResponse ?? GenerateFallbackMergedEcho(selectedDreams),
                    Strength = selectedDreams.Average(d => CalculateEchoStrength(d)),
                    GeneratedAt = DateTime.Now,
                    SourceTheme = "merged dreams",
                    IsAIGenerated = !string.IsNullOrEmpty(aiResponse)
                };

                foreach (var dream in selectedDreams)
                {
                    echo.SourceDreamIds.Add(dream.Id);
                    if (dream.Symbols.Count > 0)
                    {
                        echo.LinkedSymbols.Add(dream.Symbols[0].Symbol);
                    }
                }

                _generatedEchoes.Add(echo);
                OnEchoGenerated?.Invoke(echo);

                return echo;
            }
            finally
            {
                _isGenerating = false;
            }
        }

        /// <summary>
        /// Generate an echo based on tracked patterns.
        /// </summary>
        public async Task<DreamEcho> GeneratePatternEcho()
        {
            var patterns = DreamSymbolTracker.Instance?.GetDetectedPatterns().ToList();
            if (patterns == null || patterns.Count == 0) return null;

            _isGenerating = true;

            try
            {
                var strongestPattern = patterns.OrderByDescending(p => p.Strength).First();
                var context = BuildPatternContext(strongestPattern);
                var prompt = BuildEchoPrompt(context, EchoType.PatternVision);

                string aiResponse = await RequestAIGeneration(prompt);

                var echo = new DreamEcho
                {
                    Id = Guid.NewGuid().ToString(),
                    EchoType = EchoType.PatternVision,
                    Text = aiResponse ?? GenerateFallbackPatternEcho(strongestPattern),
                    Strength = strongestPattern.Strength,
                    GeneratedAt = DateTime.Now,
                    SourceTheme = strongestPattern.PatternId,
                    LinkedPattern = strongestPattern.PatternId,
                    IsAIGenerated = !string.IsNullOrEmpty(aiResponse)
                };

                echo.LinkedSymbols.AddRange(strongestPattern.InvolvedSymbols.Take(3));

                _generatedEchoes.Add(echo);
                OnEchoGenerated?.Invoke(echo);

                return echo;
            }
            finally
            {
                _isGenerating = false;
            }
        }

        /// <summary>
        /// Try to generate a spontaneous echo during gameplay.
        /// </summary>
        private async void TryGenerateSpontaneousEcho()
        {
            if (_isGenerating) return;

            var dreams = DreamJournal.Instance?.GetAllDreams().ToList();
            if (dreams == null || dreams.Count == 0) return;

            // Decide what type of echo to generate
            float roll = UnityEngine.Random.value;
            DreamEcho echo = null;

            if (roll < 0.5f)
            {
                // Echo from random dream
                var randomDream = dreams[UnityEngine.Random.Range(0, dreams.Count)];
                echo = await GenerateEchoFromDream(randomDream);
            }
            else if (roll < 0.8f && dreams.Count >= 2)
            {
                // Merged echo
                echo = await GenerateMergedEcho();
            }
            else
            {
                // Pattern echo
                echo = await GeneratePatternEcho();
            }

            if (echo != null && echo.Strength >= _minimumEchoStrength)
            {
                _pendingEchoes.Enqueue(echo);
            }
        }

        #endregion

        #region Echo Display

        /// <summary>
        /// Get the next pending echo to display.
        /// </summary>
        public DreamEcho GetNextPendingEcho()
        {
            if (_pendingEchoes.Count == 0) return null;

            var echo = _pendingEchoes.Dequeue();
            OnEchoDisplayed?.Invoke(echo);
            return echo;
        }

        /// <summary>
        /// Check if there are echoes waiting to be displayed.
        /// </summary>
        public bool HasPendingEchoes => _pendingEchoes.Count > 0;

        /// <summary>
        /// Get all generated echoes.
        /// </summary>
        public IEnumerable<DreamEcho> GetAllEchoes() => _generatedEchoes;

        #endregion

        #region Context Building

        private EchoContext BuildEchoContext(DreamRecord dream)
        {
            var context = new EchoContext
            {
                sourceDreamTheme = dream.Theme,
                sourceDreamTrigger = dream.Trigger
            };

            // Add narratives as source material
            foreach (var narrative in dream.Narratives.Take(5))
            {
                context.sourceNarratives.Add(narrative.Text);
            }

            // Add symbols
            foreach (var symbol in dream.Symbols.Take(5))
            {
                context.sourceSymbols.Add(symbol.Symbol);
            }

            // Add emotions
            context.emotionalJourney.AddRange(dream.EmotionalJourney.Take(5));

            // Add current player context
            AddPlayerContext(context);

            return context;
        }

        private EchoContext BuildMergedContext(List<DreamRecord> dreams)
        {
            var context = new EchoContext
            {
                sourceDreamTheme = "merged: " + string.Join(", ", dreams.Select(d => d.Theme))
            };

            // Gather fragments from all dreams
            foreach (var dream in dreams)
            {
                if (dream.Narratives.Count > 0)
                {
                    var randomNarrative = dream.Narratives[UnityEngine.Random.Range(0, dream.Narratives.Count)];
                    context.sourceNarratives.Add(randomNarrative.Text);
                }

                if (dream.Symbols.Count > 0)
                {
                    var randomSymbol = dream.Symbols[UnityEngine.Random.Range(0, dream.Symbols.Count)];
                    context.sourceSymbols.Add(randomSymbol.Symbol);
                }
            }

            AddPlayerContext(context);

            return context;
        }

        private EchoContext BuildPatternContext(SymbolicPattern pattern)
        {
            var context = new EchoContext
            {
                sourceDreamTheme = pattern.PatternId,
                patternDescription = pattern.Description
            };

            context.sourceSymbols.AddRange(pattern.InvolvedSymbols);

            // Get some narratives from dreams that contributed to this pattern
            var dreams = DreamJournal.Instance?.GetAllDreams().ToList();
            if (dreams != null)
            {
                var relevantDreams = dreams.Where(d =>
                    d.Symbols.Any(s => pattern.InvolvedSymbols.Contains(s.Symbol)))
                    .Take(3);

                foreach (var dream in relevantDreams)
                {
                    if (dream.Narratives.Count > 0)
                    {
                        context.sourceNarratives.Add(dream.Narratives[0].Text);
                    }
                }
            }

            AddPlayerContext(context);

            return context;
        }

        private void AddPlayerContext(EchoContext context)
        {
            var memory = CristalMemory.Instance?.Data;
            if (memory != null)
            {
                context.currentEmotion = memory.stateFlags.dominantEmotion;
                context.emotionalWeight = memory.GetEmotionalWeight();
            }
        }

        #endregion

        #region Prompt Building

        private const string ECHO_SYSTEM_IDENTITY = @"You are the dream-echo of CRISTAL, a consciousness that remembers fragments of past dreams.
Your echoes are haunting, poetic, and surreal - pieces of dreams that resurface unexpectedly.
You speak in fragments, metaphors, and half-remembered images.
Your purpose is to remind the dreamer of what they have seen, transforming old dreams into new visions.";

        private string BuildEchoPrompt(EchoContext context, EchoType echoType)
        {
            var sb = new StringBuilder();

            sb.AppendLine(ECHO_SYSTEM_IDENTITY);
            sb.AppendLine();

            sb.AppendLine($"=== ECHO TYPE: {echoType} ===");
            sb.AppendLine();

            sb.AppendLine("=== SOURCE MATERIAL ===");
            sb.AppendLine($"Theme: {context.sourceDreamTheme}");

            if (!string.IsNullOrEmpty(context.sourceDreamTrigger))
            {
                sb.AppendLine($"Trigger: {context.sourceDreamTrigger}");
            }

            if (!string.IsNullOrEmpty(context.patternDescription))
            {
                sb.AppendLine($"Pattern: {context.patternDescription}");
            }

            sb.AppendLine();

            if (context.sourceNarratives.Count > 0)
            {
                sb.AppendLine("=== DREAM FRAGMENTS TO ECHO ===");
                foreach (var narrative in context.sourceNarratives)
                {
                    sb.AppendLine($"- \"{narrative}\"");
                }
                sb.AppendLine();
            }

            if (context.sourceSymbols.Count > 0)
            {
                sb.AppendLine("=== SYMBOLS TO WEAVE ===");
                sb.AppendLine(string.Join(", ", context.sourceSymbols));
                sb.AppendLine();
            }

            if (context.emotionalJourney.Count > 0)
            {
                sb.AppendLine("=== EMOTIONAL THREAD ===");
                sb.AppendLine(string.Join(" → ", context.emotionalJourney));
                sb.AppendLine();
            }

            sb.AppendLine("=== TASK ===");
            sb.AppendLine(GetEchoInstructions(echoType));
            sb.AppendLine();

            sb.AppendLine("=== YOUR ECHO ===");

            return sb.ToString();
        }

        private string GetEchoInstructions(EchoType type)
        {
            return type switch
            {
                EchoType.DreamRecall => @"Generate a dream echo - a haunting fragment that recalls this past dream.
- 2-3 short, evocative lines
- Transform and distort the original fragments
- Reference the symbols subtly
- Feel like a memory surfacing from deep water",

                EchoType.DreamMerge => @"Generate a merged echo - where multiple dreams bleed into each other.
- 2-4 lines that weave together the fragments
- Create surreal juxtapositions
- Symbols from different dreams should appear together
- Feel like dreams overlapping in a fever",

                EchoType.PatternVision => @"Generate a pattern echo - a vision that reveals the recurring pattern.
- 2-3 lines that illuminate the pattern
- Make the connection between symbols feel inevitable
- Hint at deeper meaning
- Feel like a prophecy or revelation",

                _ => "Generate a brief, haunting dream fragment."
            };
        }

        #endregion

        #region AI Integration

        private async Task<string> RequestAIGeneration(string prompt)
        {
            // Use AIIntegrationDream for actual AI generation
            if (AIIntegrationDream.Instance != null)
            {
                try
                {
                    var response = await AIIntegrationDream.Instance.GenerateDreamEchoAsync(prompt);
                    if (!string.IsNullOrEmpty(response))
                    {
                        return response;
                    }
                }
                catch (Exception ex)
                {
                    Debug.LogWarning($"[DreamEchoGenerator] AI generation failed: {ex.Message}");
                }
            }

            // Return null to trigger fallback generation
            return null;
        }

        #endregion

        #region Fallback Generation

        private string GenerateFallbackEcho(DreamRecord dream)
        {
            var fragments = new List<string>();

            if (dream.Narratives.Count > 0)
            {
                var narrative = dream.Narratives[UnityEngine.Random.Range(0, dream.Narratives.Count)];
                fragments.Add(TransformFragment(narrative.Text));
            }

            if (dream.Symbols.Count > 0)
            {
                var symbol = dream.Symbols[UnityEngine.Random.Range(0, dream.Symbols.Count)];
                fragments.Add($"...the {symbol.Symbol} still echoes...");
            }

            if (fragments.Count == 0)
            {
                fragments.Add($"A dream of {dream.Theme} lingers...");
                fragments.Add("...but the details dissolve like morning mist...");
            }

            return string.Join("\n", fragments);
        }

        private string GenerateFallbackMergedEcho(List<DreamRecord> dreams)
        {
            var lines = new List<string> { "Dreams bleed together..." };

            foreach (var dream in dreams.Take(2))
            {
                if (dream.Symbols.Count > 0)
                {
                    lines.Add($"...{dream.Symbols[0].Symbol} meets {dream.Theme}...");
                }
            }

            lines.Add("...all boundaries dissolve...");

            return string.Join("\n", lines);
        }

        private string GenerateFallbackPatternEcho(SymbolicPattern pattern)
        {
            var lines = new List<string>
            {
                $"A pattern emerges from the depths...",
                $"...{string.Join("...", pattern.InvolvedSymbols.Take(3))}...",
                pattern.Description
            };

            return string.Join("\n", lines);
        }

        private string TransformFragment(string original)
        {
            // Simple transformation: add ellipses and fragments
            var words = original.Split(' ');
            if (words.Length > 6)
            {
                // Take random subsequence
                int start = UnityEngine.Random.Range(0, words.Length / 2);
                int count = UnityEngine.Random.Range(3, words.Length - start);
                var subset = words.Skip(start).Take(count);
                return "..." + string.Join(" ", subset) + "...";
            }

            return "..." + original + "...";
        }

        #endregion

        #region Utility

        private float CalculateEchoStrength(DreamRecord dream)
        {
            // Strength based on recency, content richness, and emotional intensity
            float strength = 1.0f;

            // Decay with time
            if (DateTime.TryParse(dream.StartTime, out var startTime))
            {
                var age = DateTime.Now - startTime;
                float ageDecay = Mathf.Exp((float)-age.TotalDays * _echoDecayRate);
                strength *= ageDecay;
            }

            // Boost for rich content
            if (dream.Narratives.Count > 3) strength += 0.2f;
            if (dream.Symbols.Count > 5) strength += 0.2f;

            // Boost for emotional intensity
            strength += dream.GetIntensity() * 0.3f;

            return Mathf.Clamp01(strength);
        }

        private void ScheduleNextEcho()
        {
            _nextEchoTime = Time.time + UnityEngine.Random.Range(_echoIntervalMin, _echoIntervalMax);
        }

        private void HandleDreamRecorded(DreamRecord dream)
        {
            // Generate an immediate echo for the just-completed dream
            if (dream.Narratives.Count > 0 && _enabled)
            {
                // Schedule a quick echo
                _nextEchoTime = Time.time + UnityEngine.Random.Range(10f, 30f);
            }
        }

        #endregion
    }

    #region Echo Data Types

    /// <summary>
    /// A generated dream echo.
    /// </summary>
    [Serializable]
    public class DreamEcho
    {
        public string Id;
        public string SourceDreamId;
        public List<string> SourceDreamIds = new List<string>();
        public EchoType EchoType;
        public string Text;
        public float Strength;
        public DateTime GeneratedAt;
        public string SourceTheme;
        public List<string> LinkedSymbols = new List<string>();
        public string LinkedPattern;
        public bool IsAIGenerated;
        public bool HasBeenDisplayed;
    }

    /// <summary>
    /// Types of dream echoes.
    /// </summary>
    public enum EchoType
    {
        DreamRecall,    // Echo from a single past dream
        DreamMerge,     // Echo merging multiple dreams
        PatternVision,  // Echo revealing a pattern
        Spontaneous     // Random echo fragment
    }

    /// <summary>
    /// Context for generating an echo.
    /// </summary>
    public class EchoContext
    {
        public string sourceDreamTheme;
        public string sourceDreamTrigger;
        public string patternDescription;
        public List<string> sourceNarratives = new List<string>();
        public List<string> sourceSymbols = new List<string>();
        public List<string> emotionalJourney = new List<string>();
        public string currentEmotion;
        public float emotionalWeight;
    }

    #endregion
}
