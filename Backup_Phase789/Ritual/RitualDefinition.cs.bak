using System;
using System.Collections.Generic;
using UnityEngine;
using Cristal.CLI.StateMachine;
using Cristal.CLI.Symbolic;
using Cristal.CLI.Core.Events;

namespace Cristal.CLI.Ritual
{
    /// <summary>
    /// A step in a ritual sequence.
    /// </summary>
    [Serializable]
    public class RitualStep
    {
        [Tooltip("Archetype required for this step")]
        public SymbolicArchetype requiredArchetype;

        [Tooltip("Optional: specific signal that triggers this step")]
        public SymbolicSignalType triggerSignal = SymbolicSignalType.ArcanaInvoked;

        [Tooltip("Minimum intensity required (0-100)")]
        [Range(0, 100)]
        public int minIntensity = 0;

        [Tooltip("Description shown to player when step is active")]
        [TextArea(2, 4)]
        public string hintText;

        [Tooltip("Time limit to complete this step (0 = no limit)")]
        public float timeLimit = 0f;

        [Tooltip("Audio to play when step completes")]
        public AudioClip completionSound;

        [Tooltip("Symbol projected on step completion")]
        public bool projectSymbol = true;

        /// <summary>
        /// Check if an event satisfies this step's requirements.
        /// </summary>
        public bool IsSatisfiedBy(in SymbolicEvent evt, SymbolicArchetype archetype)
        {
            if (evt.Signal != triggerSignal) return false;
            if (archetype != requiredArchetype) return false;
            if (evt.Intensity < minIntensity) return false;
            return true;
        }
    }

    /// <summary>
    /// Conditions required to begin a ritual.
    /// </summary>
    [Serializable]
    public class RitualConditions
    {
        [Tooltip("Required CristalState to start")]
        public CristalState[] allowedStates = { CristalState.Waiting, CristalState.Seeking };

        [Tooltip("Archetypes that must have been seen before")]
        public SymbolicArchetype[] prerequisiteArchetypes;

        [Tooltip("Rituals that must be completed first")]
        public RitualDefinition[] prerequisiteRituals;

        [Tooltip("Minimum memory intensity (0-100)")]
        [Range(0, 100)]
        public int minMemoryIntensity = 0;

        [Tooltip("Maximum corruption level (0-100, 100 = any)")]
        [Range(0, 100)]
        public int maxCorruptionLevel = 100;

        [Tooltip("Time of day restriction (empty = any)")]
        public string[] allowedTimeOfDay;

        /// <summary>
        /// Validate if conditions are met.
        /// </summary>
        public bool AreMet(
            CristalState currentState,
            IReadOnlyDictionary<SymbolicArchetype, bool> seenArchetypes,
            IReadOnlyCollection<string> completedRitualIds,
            int memoryIntensity,
            int corruptionLevel)
        {
            // Check state
            bool stateValid = false;
            foreach (var state in allowedStates)
            {
                if (state == currentState) { stateValid = true; break; }
            }
            if (!stateValid && allowedStates.Length > 0) return false;

            // Check prerequisite archetypes
            if (prerequisiteArchetypes != null)
            {
                foreach (var archetype in prerequisiteArchetypes)
                {
                    if (!seenArchetypes.TryGetValue(archetype, out bool seen) || !seen)
                        return false;
                }
            }

            // Check prerequisite rituals
            if (prerequisiteRituals != null)
            {
                foreach (var ritual in prerequisiteRituals)
                {
                    if (ritual != null && !completedRitualIds.Contains(ritual.ritualId))
                        return false;
                }
            }

            // Check memory/corruption thresholds
            if (memoryIntensity < minMemoryIntensity) return false;
            if (corruptionLevel > maxCorruptionLevel) return false;

            return true;
        }
    }

    /// <summary>
    /// Reward granted upon ritual completion.
    /// </summary>
    [Serializable]
    public class RitualReward
    {
        [Tooltip("Archetype unlocked by completing this ritual")]
        public SymbolicArchetype unlockedArchetype = SymbolicArchetype.None;

        [Tooltip("Memory fragment revealed")]
        [TextArea(3, 6)]
        public string revealedMemory;

        [Tooltip("State to transition to after completion")]
        public CristalState resultingState = CristalState.Remembering;

        [Tooltip("Signal to publish on completion")]
        public SymbolicSignalType completionSignal = SymbolicSignalType.RitualComplete;

        [Tooltip("Intensity of completion signal")]
        [Range(0, 100)]
        public int completionIntensity = 100;

        [Tooltip("Vision unlocked (if any)")]
        public string unlockedVisionId;

        [Tooltip("Corruption reduction amount")]
        [Range(0, 50)]
        public int corruptionReduction = 0;

        [Tooltip("Audio stinger on completion")]
        public AudioClip completionStinger;

        [Tooltip("Final symbol to project")]
        public bool projectFinalSymbol = true;

        [Tooltip("Duration of final projection")]
        public float finalProjectionDuration = 5f;
    }

    /// <summary>
    /// Defines a complete ritual sequence.
    /// 
    /// Rituals are multi-step symbolic ceremonies that require the player
    /// to invoke specific archetypes in sequence. Completing rituals
    /// unlocks new archetypes, memories, and narrative progression.
    /// </summary>
    [CreateAssetMenu(fileName = "NewRitual", menuName = "CRISTAL/Ritual/Ritual Definition")]
    public class RitualDefinition : ScriptableObject
    {
        [Header("Identity")]
        [Tooltip("Unique identifier for this ritual")]
        public string ritualId;

        [Tooltip("Display name shown to player")]
        public string displayName;

        [Tooltip("Ritual description/lore")]
        [TextArea(3, 6)]
        public string description;

        [Header("Conditions")]
        [Tooltip("Requirements to start this ritual")]
        public RitualConditions conditions;

        [Header("Sequence")]
        [Tooltip("Steps to complete the ritual in order")]
        public RitualStep[] steps;

        [Tooltip("Must steps be completed in exact order?")]
        public bool strictOrder = true;

        [Tooltip("Overall time limit for entire ritual (0 = no limit)")]
        public float totalTimeLimit = 0f;

        [Header("Reward")]
        [Tooltip("What the player gains on completion")]
        public RitualReward reward;

        [Header("Failure")]
        [Tooltip("Message shown on failure/timeout")]
        [TextArea(2, 4)]
        public string failureMessage = "The ritual dissipates, incomplete...";

        [Tooltip("Signal published on failure")]
        public SymbolicSignalType failureSignal = SymbolicSignalType.EchoTriggered;

        [Tooltip("Can be retried after failure")]
        public bool retryable = true;

        [Tooltip("Cooldown before retry (seconds)")]
        public float retryCooldown = 30f;

        [Header("Visual")]
        [Tooltip("Primary color theme for this ritual")]
        public Color ritualColor = new Color(0.5f, 0f, 1f);

        [Tooltip("Shape language for ritual symbols")]
        public ShapeLanguage shapeLanguage = ShapeLanguage.Sacred;

        [Tooltip("Ambient audio during ritual")]
        public AudioClip ambientLoop;

        [Header("Debug")]
        [Tooltip("Log ritual progress to console")]
        public bool debugLogging = false;

        /// <summary>
        /// Get total step count.
        /// </summary>
        public int StepCount => steps?.Length ?? 0;

        /// <summary>
        /// Get step at index.
        /// </summary>
        public RitualStep GetStep(int index)
        {
            if (steps == null || index < 0 || index >= steps.Length)
                return null;
            return steps[index];
        }

        /// <summary>
        /// Get all required archetypes for this ritual.
        /// </summary>
        public SymbolicArchetype[] GetRequiredArchetypes()
        {
            if (steps == null) return Array.Empty<SymbolicArchetype>();

            var archetypes = new SymbolicArchetype[steps.Length];
            for (int i = 0; i < steps.Length; i++)
            {
                archetypes[i] = steps[i].requiredArchetype;
            }
            return archetypes;
        }

        /// <summary>
        /// Validate ritual definition.
        /// </summary>
        public bool Validate(out string error)
        {
            if (string.IsNullOrEmpty(ritualId))
            {
                error = "Ritual ID is required";
                return false;
            }

            if (steps == null || steps.Length == 0)
            {
                error = "Ritual must have at least one step";
                return false;
            }

            for (int i = 0; i < steps.Length; i++)
            {
                if (steps[i].requiredArchetype == SymbolicArchetype.None)
                {
                    error = $"Step {i + 1} has no required archetype";
                    return false;
                }
            }

            error = null;
            return true;
        }

        private void OnValidate()
        {
            if (string.IsNullOrEmpty(ritualId))
            {
                ritualId = name.ToLowerInvariant().Replace(" ", "_");
            }

            if (conditions == null)
            {
                conditions = new RitualConditions();
            }

            if (reward == null)
            {
                reward = new RitualReward();
            }
        }

        #region Factory Methods

        /// <summary>
        /// Create a simple single-step ritual.
        /// </summary>
        public static RitualDefinition CreateSimple(
            string id,
            SymbolicArchetype requiredArchetype,
            SymbolicArchetype rewardArchetype)
        {
            var ritual = CreateInstance<RitualDefinition>();
            ritual.ritualId = id;
            ritual.displayName = $"Ritual of {requiredArchetype}";
            ritual.description = $"Invoke {requiredArchetype} to unlock {rewardArchetype}";

            ritual.steps = new RitualStep[]
            {
                new RitualStep
                {
                    requiredArchetype = requiredArchetype,
                    triggerSignal = SymbolicSignalType.ArcanaInvoked,
                    hintText = $"Invoke {requiredArchetype}..."
                }
            };

            ritual.reward = new RitualReward
            {
                unlockedArchetype = rewardArchetype,
                resultingState = CristalState.Remembering
            };

            ritual.conditions = new RitualConditions();

            return ritual;
        }

        /// <summary>
        /// Create a three-step progression ritual.
        /// </summary>
        public static RitualDefinition CreateProgression(
            string id,
            SymbolicArchetype step1,
            SymbolicArchetype step2,
            SymbolicArchetype step3,
            SymbolicArchetype reward)
        {
            var ritual = CreateInstance<RitualDefinition>();
            ritual.ritualId = id;
            ritual.displayName = $"The Path of {reward}";
            ritual.description = $"A journey through {step1}, {step2}, and {step3}";
            ritual.strictOrder = true;

            ritual.steps = new RitualStep[]
            {
                new RitualStep
                {
                    requiredArchetype = step1,
                    triggerSignal = SymbolicSignalType.ArcanaInvoked,
                    hintText = "Begin with the first symbol..."
                },
                new RitualStep
                {
                    requiredArchetype = step2,
                    triggerSignal = SymbolicSignalType.ArcanaInvoked,
                    hintText = "Continue the sequence..."
                },
                new RitualStep
                {
                    requiredArchetype = step3,
                    triggerSignal = SymbolicSignalType.ArcanaInvoked,
                    hintText = "Complete the triad..."
                }
            };

            ritual.reward = new RitualReward
            {
                unlockedArchetype = reward,
                resultingState = CristalState.Invoked,
                completionIntensity = 100
            };

            ritual.conditions = new RitualConditions();
            ritual.shapeLanguage = ShapeLanguage.Sacred;

            return ritual;
        }

        #endregion
    }
}
